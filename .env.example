# Copy to .env, then fill in ONE key. chmod 600 .env
# The bridge auto-detects whichever provider you configure.

# Google Gemini — free tier ok for text models
GEMINI_API_KEY=

# OpenRouter — one key, many free models (append :free to model ids)
OPENROUTER_API_KEY=

# Optional others
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Local keyless models (Ollama / vLLM / LM Studio)
# OLLAMA_BASE_URL=http://localhost:11434/v1
